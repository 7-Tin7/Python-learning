# ---- Python 缓存 ----
__pycache__/
*.pyc
*.pyo

# ---- 编辑器配置（每个人不同，不上传）----
.idea/
.vscode/
*.swp

# ---- 个人数据文件（程序运行时生成的，不上传）----
日记.txt
学习内容.txt
打卡记录.txt
任务清单.txt
学习记录.txt
笔记.txt

# ---- 个人的职业规划 / 私密笔记（不上传）----
学习建议.txt
求职准备清单.txt

# ---- ⚠️⚠️ 内部教学文档 / 求职材料（含个人能力评估和学习短板，绝不上传）----
# 学习交接说明.md：含"常见错误模式""禁写清单""真实水平评估" → 上传 = 把短板交给面试官
学习交接说明.md
notes/简历_*.txt
notes/岗位推荐与技能建议_应届生版.txt

# ---- ⚠️⚠️ 密钥 / 环境变量（绝对不能上传！！）----
# API Key 泄露 = 别人用你的账号花钱，而且无法撤回（Git 历史里永久留存）
# 第 6.6 单元学 LLM 会用到 DEEPSEEK_API_KEY，务必靠这段挡住
.env
.env.*
!.env.example
*.key
secrets.*

# ---- 程序生成的输出文件（可随时重新生成）----
分析结果.csv
*结果.csv

# ---- 嵌套的独立仓库（避免 Git 冲突，单独在 GitHub 上有 git-practice）----
git练习/

# ---- 临时文件（约定：文件名以 _ 开头 = 用完即删，不上传）----
_*.py
_*.txt
_*.md
!_demo_*.py

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini
